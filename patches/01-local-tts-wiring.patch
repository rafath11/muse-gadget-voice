+/*
+ * Moves MP3 from the local HTTP TTS worker into the decoder's buffer, with
+ * the same backpressure as the stream path (nothing is read while the
+ * buffer is full). When the fetch ends with audio, decode() drains it and
+ * finishes the message. When it fails before any audio arrived, Muse's
+ * own TTS stream is tried for the message, then reading pace.
+ */
+static void pump_local_tts(void)
+{
+    if (!s_turn.tts_local || s_turn.tts_msg < 0) {
+        return;
+    }
+    size_t room = MP3_BUF - s_turn.mp3_len;
+    if (!room) {
+        return;
+    }
+    uint8_t data[2048];
+    muse_tts_status_t status;
+    size_t n = muse_tts_read(s_turn.tts_local, data, room < sizeof(data) ? room : sizeof(data), &status);
+    if (n) {
+        tts_data(data, n);
+    }
+    if (status == MUSE_TTS_PENDING) {
+        return;
+    }
+    int i = s_turn.tts_msg;
+    s_turn.tts_local = 0;
+    if (status == MUSE_TTS_END || s_turn.mp3_len) {
+        s_turn.mp3_ended = true;   /* decode() drains the rest, then finishes */
+    } else if (open_tts_stream(i, false)) {
+        ESP_LOGW(TAG, "local TTS failed; falling back to Muse's speech stream for %s", s_turn.msgs[i].id);
+        mark(M_TTS);
+    } else {
+        ESP_LOGW(TAG, "local TTS failed; showing %s as text", s_turn.msgs[i].id);
+        pace_as_text(s_turn.msgs[i]);
+    }
+}
